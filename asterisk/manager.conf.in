; PhoneSystem AMI config (installed to /etc/asterisk/manager.conf by
; deploy/install.sh, which replaces @AMI_SECRET@ with a random secret).
; AMI only listens on localhost; the web UI talks to Asterisk through it.

[general]
enabled = yes
port = 5038
bindaddr = 127.0.0.1
displayconnects = no

[phonesystem]
secret = @AMI_SECRET@
deny = 0.0.0.0/0.0.0.0
permit = 127.0.0.1/255.255.255.255
read = system,call,reporting,config,command
write = system,call,reporting,originate,config,command
