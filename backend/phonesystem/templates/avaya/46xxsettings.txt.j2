## PhoneSystem settings file for Avaya 96x1 SIP deskphones (9608 / 9608G).
## Generated by PhoneSystem. Do not edit: changes are overwritten.
## Lines starting with ## are comments. Phones ignore settings they don't know.

## ---- Call server -------------------------------------------------------
SET SIPDOMAIN {{ sip_domain }}
## Must be a numeric IPv4 address. 96x1 SIP phones use TCP (or TLS), not UDP.
SET SIP_CONTROLLER_LIST {{ server_ip }}:{{ settings.sip_tcp_port }};transport=tcp
## Standard SIP ("SIPPING 19") mode, for a non-Avaya call server.
SET ENABLE_AVAYA_ENVIRONMENT 0
SET DISCOVER_AVAYA_ENVIRONMENT 0
SET ENFORCE_SIPS_URI 0
SET REGISTERWAIT {{ settings.register_interval }}

## ---- Time ----------------------------------------------------------------
SET SNTPSRVR {{ settings.ntp_server }}
SET GMTOFFSET "{{ settings.gmt_offset }}"
SET DSTOFFSET {{ settings.dst_offset }}
SET DSTSTART "{{ settings.dst_start }}"
SET DSTSTOP "{{ settings.dst_stop }}"

## ---- Dialing ---------------------------------------------------------------
{% if dialplan %}
## Numbers that dial as soon as they're complete (no need to press Call).
SET DIALPLAN {{ dialplan }}
{% endif %}
SET INTER_DIGIT_TIMEOUT {{ settings.inter_digit_timeout }}

## ---- Phone admin (craft) menu password ---------------------------------
SET PROCPSWD {{ settings.phone_admin_password }}
{% if settings.phone_syslog %}

## ---- Send phone logs to PhoneSystem (shown on the phone's page) ----------
SET LOGSRVR {{ server_ip }}
SET SYSLOG_ENABLED 1
{% endif %}
{% if phone %}

## ---- This phone ({{ phone.mac }}) logs in automatically as {{ phone.extension }}
SET FORCE_SIP_USERNAME {{ phone.extension }}
SET FORCE_SIP_EXTENSION {{ phone.extension }}
SET FORCE_SIP_PASSWORD {{ phone.password }}
{% endif %}
{% if extra %}

## ---- Extra settings added in the web UI ------------------------------------
{% for line in extra %}
{{ line }}
{% endfor %}
{% endif %}
