; Generated by PhoneSystem. Do not edit: changes here are overwritten.
; Edit extensions and settings in the web UI instead.

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:{{ settings.sip_tcp_port }}

; Avaya 96x1 SIP phones only speak SIP over TCP (or TLS).
[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:{{ settings.sip_tcp_port }}
{% for ext in extensions %}

; ---- {{ ext.number }}: {{ ext.name }}
[{{ ext.number }}]
type=endpoint
context=from-internal
disallow=all
allow=g722,ulaw,alaw
auth={{ ext.number }}
aors={{ ext.number }}
callerid="{{ ext.name }}" <{{ ext.number }}>
; The 9608 shows caller names from P-Asserted-Identity.
send_pai=yes
trust_id_outbound=yes
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

[{{ ext.number }}]
type=auth
auth_type=userpass
username={{ ext.number }}
password={{ ext.sip_password }}

[{{ ext.number }}]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=60
{% endfor %}
